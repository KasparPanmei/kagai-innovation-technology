
NODE_ENV=development
PORT=5000

# Select database: local or atlas
MONGODB_MODE=local

# Local MongoDB
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/kagai_innovation_technology

# MongoDB Atlas
MONGODB_ATLAS_URI=

# Database timeout
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Frontend URL
CLIENT_ORIGIN=http://localhost:5173
